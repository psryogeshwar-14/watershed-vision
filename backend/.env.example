# ─────────────────────────────────────────────────────────────
#  WatershedVision – Environment Configuration Example
#  Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL + PostGIS connection string
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://watershedvision:password@localhost:5432/watershedvision_db

# Google Earth Engine (GEE) service-account email
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Absolute path to the GEE private-key JSON file
GEE_KEY_FILE=/path/to/gee-service-account-key.json

# Google Gemini Vision API key
GEMINI_API_KEY=AIza...

# JWT secret key – use a long random string in production
SECRET_KEY=change-me-to-a-very-long-random-secret-key-at-least-32-chars

# Directory where uploaded field images are stored
UPLOAD_DIR=./uploads

# Maximum allowed upload file size in bytes (default: 50 MB)
MAX_FILE_SIZE=52428800
